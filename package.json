{
    "name": "jamendo-ts-client",
    "version": "0.0.0",
    "description": "TypeScript client for the Jamendo API",
    "license": "MIT",
    "author": "Angel S. Moreno",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "jamendo",
        "api",
        "client",
        "music",
        "typescript"
    ],
    "scripts": {
        "prepare": "lefthook install",
        "build": "tsc -p tsconfig.build.json",
        "check:types": "tsc --noEmit",
        "check:dead-code": "bun run fallow dead-code",
        "check:dupes": "bun run fallow dupes",
        "check:health": "bun run fallow health",
        "check:audit": "bun run fallow audit",
        "lint": "biome check .",
        "lint:fix": "biome check --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.9",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@types/bun": "^1.3.14",
        "fallow": "^3.17.0",
        "lefthook": "^2.1.10",
        "typescript": "^7.0.2"
    }
}
