# Jamendo API client — required for integration tests + live calls.
# Copy to .env and fill in. .env is gitignored; this template is not.
JAMENDO_CLIENT_ID=your_client_id_here
# OAuth2 (user-scoped: /users/*, /setuser/*). Get these from the OAuth2
# Authorization Code Grant flow (see https://developer.jamendo.com/v3.0/oauth).
# access_token expires in 2h; client_secret + refresh_token enable auto-refresh.
# JAMENDO_CLIENT_SECRET=your_client_secret_here
# JAMENDO_ACCESS_TOKEN=your_access_token_here
# JAMENDO_REFRESH_TOKEN=your_refresh_token_here